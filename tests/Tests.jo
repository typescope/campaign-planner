//[ Tests.jo
  !
  ! The entry point for this suite: `jo run tests`, after the sandbox is built.
  !
  ! Two things are worth proving. That the boundary is real: a program that
  ! reaches past `Promotions` does not compile. And that a program inside it
  ! still cannot save a draft the campaign's limits do not allow. Neither needs
  ! an API key or the network.
//]

namespace campaign.planner.tests.Main

import jo.IO.stdout
import harpe.logging.Logging
import harpe.logging.logger
import harpe.testing.Testing
import harpe.testing.Runner
import harpe.testing.suite
import harpe.testing.thisSuite
import campaign.planner.tests.ShopTest
import campaign.planner.tests.BoundaryTest
import campaign.planner.tests.ServerTest
import campaign.planner.tests.LogTest
import campaign.planner.tests.MigrationsTest

def main(): Unit receives stdout =
  Logging.withLogger(Logging.discard, () => run())

private def run(): Unit receives stdout, logger =
  val root = Testing.define("campaign-planner", () => suites())
  val passed = Runner.run(root, Runner.filterFromArgs(), Runner.lanesFromEnv())
  if !passed then py.module("sys").exit(1)
  println ""
  println "all campaign-planner tests passed"

private def suites(): Unit receives thisSuite, logger =
  suite: "migrations", () => MigrationsTest.migrationsSuite()
  suite: "shop", () => ShopTest.shopSuite()
  suite: "boundary", () => BoundaryTest.boundarySuite()
  suite: "server", () => ServerTest.serverSuite()
  suite: "logs", () => LogTest.logSuite()
