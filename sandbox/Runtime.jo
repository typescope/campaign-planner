namespace sandbox.runtime

import jo.IO.stdout
import harpe.ffi.os
import harpe.logging.*
import sandbox.api

//[ Starts the program with the implementation bound. The database path and the
  ! campaign arrive in the environment from the app, never from the program.
//]
def main(): Unit receives stdout =
  val path = os.getenv("CAMPAIGN_DB", "")
  val campaign = Int.parse(os.getenv("CAMPAIGN_ID", "")) rescue None => 0
  val run = Int.parse(os.getenv("CAMPAIGN_RUN", "")) rescue None => 0
  if path == "" || campaign == 0 || run == 0 then
    abort "sandbox: CAMPAIGN_DB, CAMPAIGN_ID and CAMPAIGN_RUN must be set"

  Logging.withLogger: auditLogger(), () =>
    with api.promotions = new PromotionsImpl(path, campaign, run) in api.runTask()

private def auditLogger(): Logger =
  val path = os.getenv("HARPE_AUDIT_LOG", "")
  if path == "" then Logging.discard else new JsonlLogger(path)
