namespace campaign.planner

import harpe.ffi.os
import harpe.Model
import harpe.server.Http
import harpe.server.Request
import harpe.server.Response
import harpe.server.request
import campaign.planner.db.DB
import campaign.planner.db.conn
import campaign.planner.db.Shop
import campaign.planner.db.Campaigns

class Server(home: String, databasePath: String, brain: Option[Model])
  private val planner = new Planner(home, databasePath, brain)

  //[ The routes that need no connection, then everything else on one
    ! connection for the request. A run opens its own connections, because it
    ! lasts minutes and only its start and end touch the database here.
  //]
  def route(): Response receives request =
    match request
    case Request.Get("/") => asset("index.html")
    case Request.Get("/app.css") => asset("app.css")
    case Request.Get("/app.js") => asset("app.js")
    case Request.Post(path) if path.startsWith("/api/campaigns/") =>
      match Request.segments(path)
      case ["api", "campaigns", id, "run"] => refusable(() => runCampaign(id))
      case _ => notFound()
    case Request.Get(path) if path.startsWith("/api/runs/") =>
      match Request.segments(path)
      case ["api", "runs", id, "programs"] =>
        Response.json: py.dict("programs" ~ Campaigns.programs(planner.logsDir, number(id)))
      case _ => notFound()
    case _ => refusable(() => DB.withConn(databasePath, () => connected()))

  private def connected(): Response receives request, conn =
    match request
    case Request.Get("/api/snapshot") =>
      Response.json: py.dict:
        "counts"    ~ Shop.counts
        "campaigns" ~ Campaigns.campaigns
        "has_model" ~ planner.hasModel
    case Request.Get("/api/customers") => Response.json: py.dict("customers" ~ Shop.customers)
    case Request.Get("/api/orders") => Response.json: py.dict("orders" ~ Shop.orders)
    case Request.Get("/api/coupons") => Response.json: py.dict("coupons" ~ Shop.coupons)
    case Request.Get(path) if path.startsWith("/api/campaigns/") =>
      match Request.segments(path)
      case ["api", "campaigns", id] =>
        Response.json: py.dict("campaign" ~ Campaigns.campaign(number(id)))
      case _ => notFound()
    case Request.Post("/api/campaigns") => ok(py.dict("id" ~ Campaigns.save(readJson())))
    case Request.Post("/api/coupons/approve") =>
      Campaigns.approve(readJson().get("id", 0).asInt)
      ok(py.dict())
    case Request.Post("/api/coupons/reject") =>
      Campaigns.reject(readJson().get("id", 0).asInt)
      ok(py.dict())
    case _ => notFound()

  //[ A run answers when it ends, with what the AI or the example reported. //]
  private def runCampaign(id: String): Response receives request =
    val mode = readJson().get("mode", "").asString
    Response.json: planner.run(number(id), mode)

  private def readJson(): py.Dict receives request =
    request.json() rescue None => abort "Expected a JSON object."

  private def notFound(): Response =
    Response.json: py.dict("error" ~ "not found"), status = Http.Status.NotFound

  private def number(text: String): Int = Int.parse(text) rescue None => 0

  private def ok(extra: py.Dict): Response =
    extra.set("ok", true)
    Response.json: extra

  //[ Everything the shop declines to do is declined for a stated reason, so
    ! the owner sees the reason rather than a bare error.
  //]
  private def refusable(handler: () => Response): Response =
    match py.try(handler())
    case Ok(response) => response
    case Err(error) =>
      Response.json: py.dict("error" ~ error.message), status = Http.Status.BadRequest

  private def asset(name: String): Response =
    Response.file(os.path.join(home, "assets"), name)
end
