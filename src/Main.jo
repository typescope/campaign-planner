namespace campaign.planner

import jo.IO.stdout
import harpe.ffi.os
import harpe.ffi.sys
import harpe.util.Process
import harpe.util.File
import harpe.server.WebApp
import harpe.server.Route
import harpe.Model
import campaign.planner.db.DB

def main(): Unit receives stdout =
  Process.loadDotenv(".env")
  val home = os.path.abspath(".")
  val host = os.getenv("HOST", "127.0.0.1")
  val unsafe = py.dynamic(os.getenv("ALLOW_UNSAFE_REMOTE", "false")).lower().asString == "true"
  if !isLoopback(host) && !unsafe then
    println "Refusing to bind to \{host}: Campaign Planner has no authentication."
    println "Use 127.0.0.1, localhost, or ::1. ALLOW_UNSAFE_REMOTE=true is an explicit unsafe override."
    sys.exit(1)

  val dataDir = os.path.join(home, "data")
  File.ensureDir(dataDir)
  val databasePath = os.path.join(dataDir, "shop.db")
  DB.initialize(databasePath)

  val port = Int.parse(os.getenv("PORT", "8768")) rescue None => 8768
  // Model.default() stops the app when no key is set, and the example program
  // needs none, so a model is made only when a key is there.
  val keyed = os.getenv("OPENAI_API_KEY", "") != "" || os.getenv("OPENROUTER_API_KEY", "") != ""
    || os.getenv("ANTHROPIC_API_KEY", "") != ""
  val brain: Option[Model] = if keyed then Some(Model.default()) else None
  val server = new Server(home, databasePath, brain)
  val application = new WebApp:
    host = WebApp.Loopback
    routes = []
    fallback = WebApp.Fallback(() => server.route(), maxBodyBytes = Route.defaultMaxBodyBytes)
  val httpd = py.module("waitress").create_server:
    application.wsgi()
    host = host
    port = port
    threads = 16
    max_request_body_size = application.maxRequestBodyBytes

  println """
    Campaign Planner · Alpine Roasters demo shop

    Live at http://\{host}:\{port}
    The AI-generated program sees purchase dates and amounts, never who bought.
    Ctrl-C to stop
  """
  Process.shutdownOnSigint("\nCampaign Planner stopped.")
  httpd.run()

private def isLoopback(host: String): Bool =
  host == "127.0.0.1" || host == "localhost" || host == "::1"
