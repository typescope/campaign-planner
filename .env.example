# Set one model provider key to let the AI write programs. "Run the example
# program" needs no key. The provider is chosen by which key is present, in this
# order: OpenAI, then OpenRouter, then Anthropic.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# OpenRouter also requires MODEL: there is no sensible default model id for it.
# OPENROUTER_API_KEY=
# MODEL=anthropic/claude-sonnet-4.5

HOST=127.0.0.1
PORT=8768

# This app has no authentication. Do not enable this casually.
ALLOW_UNSAFE_REMOTE=false
